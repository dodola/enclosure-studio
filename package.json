{
  "name": "enclosure-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/concurrently/dist/bin/concurrently.js -k -n api,ai,web \".venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 8011 --reload --reload-dir server\" \"npm run dev:ai\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "test": ".venv/bin/python -m pytest server/tests -q && npm run test:agent",
    "start": "node scripts/serve.mjs",
    "setup:login": "PYTHONPATH=. .venv/bin/python scripts/setup_login.py",
    "deploy:service": "node scripts/install_service.mjs",
    "dev:ai": "node --watch agent/server.mjs",
    "test:agent": "node --test agent/tests/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
