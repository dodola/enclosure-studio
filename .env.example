# Keys are loaded by the Node Pi service only; never use a VITE_ prefix.
# You can also configure credentials in the page's AI settings. Saved settings take precedence.
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-6
PI_API_KEY=
# Alternatively use the provider's standard ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY.

# Optional compatible endpoint, with a model that supports tool calls (and images for annotation).
# PI_PROVIDER=custom
# PI_MODEL=your-vision-model-id
# PI_BASE_URL=https://your-provider.example/v1
# PI_API=openai-completions
# PI_VISION=true

# Optional: explicit Pi auth file for existing Pi credentials. Default is isolated .pi-state/auth.json.
# PI_AUTH_FILE=/absolute/path/to/pi/auth.json
# PI_PORT=8012
# GEOMETRY_URL=http://127.0.0.1:8011

# LAN production server: npm run setup:login && npm run build && npm start.
# Login is mandatory in production. This file must stay outside dist/ and Git.
# ENCLOSURE_AUTH_FILE=/absolute/path/to/login.json
# ENCLOSURE_HOST=0.0.0.0
# ENCLOSURE_PORT=5176
